    "flow_domain_id": "northeast_taiwan_common_cache_v3",
    "bbox_lon_lat": [121.91, 122.06, 25.0, 25.15],
    "bbox_order": "lon_min, lon_max, lat_min, lat_max",
    "anchor_lonlat": [121.92807, 25.11245],
    "analysis_unit_id": "gongliao_surface_svd_candidate_v3",
    "source_analysis_units_config": "OCM-Data-Preprocessing/configs/ocm_svd_analysis_units_v1.json",
    "source_analysis_units_config_sha256": "4af676a1560833c19f527432ca57d4e4bf0a83cdf79a1e32aa1f471fba7f7c28",
    "spatial_mask_policy": "analysis_bbox_cell_center",
