    "bbox_order": "lon_min, lon_max, lat_min, lat_max",
    "center_lonlat": [120.893355, 22.0],
    "source_flow_domains_config": "OCM-Data-Preprocessing/configs/ocm_flow_domains.json",
    "source_flow_domains_config_sha256": "b8db61c38138d5690d203bf1b3785c6b2e581572d08f097573772c554ef373b3"
  },
  "input": {
