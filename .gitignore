# Python、uv 與測試暫存檔不屬於可重現分析的原始碼。
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.coverage

# SERVER 或本機的大型快取與 SVD 衍生陣列都由流程重建，不應納入版本控制。
outputs/
derived/
data/

# macOS Finder 產生的中介檔與研究程式無關。
.DS_Store
# temp。
tmp/
work/

# bash 腳本每次執行的 JSON runtime log；它們記錄主機、參數與實際成果，屬於當次作業
# 證據而非可重現原始碼，不應混入版本控制。
logs/
